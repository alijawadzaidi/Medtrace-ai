# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------------------
# Database
#
# DB_DIALECT=sqlite  -> zero-install local development (default)
# DB_DIALECT=mysql   -> the production target; fill in the DB_* values below
# ---------------------------------------------------------------------------
DB_DIALECT=sqlite
DB_STORAGE=./medtrace.dev.sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medtrace
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# ---------------------------------------------------------------------------
# Auth (Phase 1)
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-before-you-commit-anything-real
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# Public verification (Phase 4)
#
# The QR code on every pack encodes VERIFY_BASE_URL/<serial>. Point it at the
# customer-facing page, not the API: a phone camera opens a web page, and the
# page calls the API. Labels are printed with this baked in, so changing it
# invalidates every label already in circulation — set it before any real print
# run.
# ---------------------------------------------------------------------------
VERIFY_BASE_URL=http://localhost:3000/v
CORS_ORIGIN=*
