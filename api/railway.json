{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "//": "Migrations run before the new version takes traffic. A deploy that cannot migrate should not start serving.",
    "preDeployCommand": ["npx sequelize-cli db:migrate --env production"],
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
